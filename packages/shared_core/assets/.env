# Shared environment for all apps in the orient_mobile workspace.
#
# BASE_URL is the SINGLE source for the API endpoint (dev AND production) —
# no --dart-define required. The .env is declared as an asset and ships inside
# the APK, so production builds must set the real https URL HERE before building.
#
# - Development: http://localhost:8080/api/v1 or your LAN/tunnel URL.
# - Production: BASE_URL=https://g.erpmass.com/api/v1  (set before build;
#   release builds FAIL at startup if the URL is missing, http://, or localhost).
#
# FIX (audit P0): the devtunnel URL was removed — devtunnel endpoints are
# ephemeral and expose the API through an unauthenticated tunnel; shipping it
# silently misrouted production builds.
BASE_URL=https://g.erpmass.com/api/v1
APP_ENV=production
