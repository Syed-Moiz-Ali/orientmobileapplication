# Shared environment for all apps in the orient_mobile workspace.
#
# BASE_URL is intentionally left unset here: production/staging builds must
# provide it at build time via --dart-define=BASE_URL=https://... (see
# EnvironmentConfig in packages/shared_core/lib/src/local/helpers/environment_config.dart).
# Local development defaults to http://localhost:8080/api/v1 when nothing is set.
