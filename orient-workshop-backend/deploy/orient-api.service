[Unit]
Description=Orient Workshop Backend API
After=network.target mysql.service redis.service
Wants=mysql.service redis.service

[Service]
Type=simple
User=orient
WorkingDirectory=/opt/orient-api
# CR-6: no secrets in this file. All environment values (DB password, JWT secret,
# encryption key, ...) live in /etc/orient/orient-api.env, which is NOT committed.
EnvironmentFile=/etc/orient/orient-api.env
# FIX (audit P0): deploy.sh now copies the JAR to this exact path, and the
# `prod` profile is used (previously `mysql` bypassed the prod security posture).
ExecStart=/usr/bin/java -jar /opt/orient-api/orient-gateway.jar --spring.profiles.active=prod
Restart=on-failure
RestartSec=10
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
