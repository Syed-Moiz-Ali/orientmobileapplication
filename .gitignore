# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/
# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
# FIX (audit P0): root-anchored patterns missed nested build dirs — 36 build
# artifacts (packages/*/build/**, apps/*/build/**) were tracked.
**/build/
**/coverage/
**/ephemeral/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
**/android/app/debug
**/android/app/profile
**/android/app/release

# Environment files (the shared_core/assets/.env template is tracked by design;
# anything else with secrets must never be)
.env
.env.*
*.p12
*.jks
*.keystore

# Scratch / agent files
error.txt
javaerror.txt
promt.txt
change.txt

# Release signing secrets (never commit)
android_keystore/
**/android/key.properties
